# PSK Game Recommender - environment template
#
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
# The prototype runs with all defaults - nothing here is required to start it,
# and none of these are secrets. The block at the bottom lists the credentials a
# production deployment would need, so a reviewer can see where they would go.

# --- service ---------------------------------------------------------------
MTG_HOST=127.0.0.1
MTG_PORT=8000
MTG_LOG_LEVEL=info

# --- demo session ----------------------------------------------------------
# Signs the demo login cookie. The default is a known dev value and logs a
# warning; set a real random value for anything beyond a local demo.
# MTG_SESSION_SECRET=

# --- artifacts -------------------------------------------------------------
# Built by: python -m src.pipeline.build_dataset --source path/to/CA_Player.csv
#           python -m src.recsys.train
MTG_ARTIFACTS_DIR=artifacts

# --- lobby -----------------------------------------------------------------
MTG_ROW_SIZE=8
MTG_HEAD_N=50
MTG_MAX_PER_PROVIDER=3

# --- rollout ---------------------------------------------------------------
# Log recommendations without rendering them. This is how it ships on day one.
MTG_SHADOW_MODE=true
MTG_ROLLOUT_FRACTION=0.0

# --- production integrations (NOT used by the prototype) --------------------
# Left blank on purpose. A real deployment injects these from the platform's
# secret manager; they are never read from a file in the repository.
# MTG_REDIS_URL=
# MTG_KAFKA_BROKERS=
# MTG_EXCLUSION_REGISTER_URL=
# MTG_EXCLUSION_REGISTER_TOKEN=
# MTG_GAME_CATALOGUE_URL=
